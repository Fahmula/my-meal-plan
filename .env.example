# Copy to .env and adjust:  cp .env.example .env

# Host port for the web interface (http://<server>:APP_PORT)
APP_PORT=3000

# Where the database and uploaded images live on the host
DATA_PATH=./data

# Owner of files written to DATA_PATH (run `id` on the host to find yours)
PUID=1000
PGID=1000

# Container clock / log timezone
TZ=America/New_York

# Timezone used the first time the app starts (change it later in Settings)
DEFAULT_TIMEZONE=America/New_York

# Optional: the URL you use to open this app, e.g. http://192.168.1.20:3000
# When set, webhooks include an "image_url" Home Assistant can show in notifications.
APP_BASE_URL=

# debug | info | warning | error
LOG_LEVEL=info
